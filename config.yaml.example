llm:
  base_url: "http://localhost:4000"
  model: "openai/gpt-4"
  api_key: "sk-1234"
  temperature: 0.7
  max_tokens: 4096

prompts:
  default_version: "v1"
  templates_dir: "src/prompts/templates"

workflow:
  max_iterations: 10
  verbose: true

conversation:
  max_history_turns: 20
  include_plan_detail_turns: 1

search:
  tool_name: "tavily-search"        # must match LiteLLM proxy search_tools config
  default_depth: "basic"            # "basic" or "advanced"
  max_results: 5                    # default max results
  timeout: 10                       # HTTP timeout in seconds

eval:
  base_url: "http://localhost:4000"
  model: "openai/gpt-4"
  api_key: "sk-1234"
  temperature: 0.7
  threshold: 0.7

observability:
  provider: "langfuse"  # "langfuse" | "noop"

langfuse:
  public_key: "${LANGFUSE_PUBLIC_KEY}"
  secret_key: "${LANGFUSE_SECRET_KEY}"
  host: "${LANGFUSE_HOST:-http://localhost:3000}"
